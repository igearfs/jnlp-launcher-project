#!/bin/bash

# Post-installation tasks for SyncSyndicate

# Get the user who invoked the script (SUDO_USER or fallback to whoami)
CURRENT_USER=${SUDO_USER:-$(whoami)}
SUDO_USER_HOME=$(eval echo ~$SUDO_USER)

MAIN_DIR="$SUDO_USER_HOME/SyncSyndicate"
INSTALL_DIR="$MAIN_DIR/syncsyndicate"  # Update path for the new binary location
SYMLINK_PATH="$SUDO_USER_HOME/.local/bin/SyncSyndicate"
LAUNCHER_PATH="$SUDO_USER_HOME/.local/share/applications/SyncSyndicate.desktop"
ICON="$INSTALL_DIR/lib/icon/RIP4.png"

# Check if the necessary directories exist
if [ ! -d "$INSTALL_DIR/bin" ]; then
    echo "Error: Directory $INSTALL_DIR/bin does not exist. Please check your build process."
    exit 1
fi

if [ ! -d "$(dirname "$SYMLINK_PATH")" ]; then
    echo "Error: Directory $(dirname "$SYMLINK_PATH") does not exist. Please check your build process."
    exit 1
fi

if [ ! -d "$(dirname "$LAUNCHER_PATH")" ]; then
    echo "Error: Directory $(dirname "$LAUNCHER_PATH") does not exist. Please check your build process."
    exit 1
fi

# Fix ownership and permissions for all files in the installation directory
echo "Fixing ownership and permissions for $INSTALL_DIR"

# Change ownership of the install directory and its contents to the current user
sudo chown -R $CURRENT_USER:$CURRENT_USER "$MAIN_DIR"

# Ensure executables are marked as executable
sudo chmod +x "$INSTALL_DIR/bin/SyncSyndicate"  # Adjust binary path here

# Ensure the symlink is created and executable
if [ ! -L "$SYMLINK_PATH" ]; then
    echo "Creating symlink at $SYMLINK_PATH"
    ln -s "$INSTALL_DIR/bin/SyncSyndicate" "$SYMLINK_PATH" || { echo "Failed to create symlink!"; exit 1; }
fi

# Ensure the .desktop entry is executable
if [ -f "$LAUNCHER_PATH" ]; then
    sudo chmod +x "$LAUNCHER_PATH"
fi

# Ensure the icon exists
if [ ! -f "$ICON" ]; then
    echo "Icon file not found! Please add a valid icon to $ICON."
    exit 1
fi

# Create desktop entry for application launcher
echo "Creating desktop entry for $APP_NAME"
cat > "$LAUNCHER_PATH" << EOL
[Desktop Entry]
Name=SyncSyndicate
Exec=$INSTALL_DIR/bin/syncsyndicate
Icon=$ICON
Terminal=false
Type=Application
Categories=Utility;
EOL

chmod +x "$LAUNCHER_PATH"

echo "Installation completed successfully!"
