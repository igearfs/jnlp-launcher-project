<configuration>

    <!-- Define log directory properties from system properties, with fallbacks -->
    <property scope="context" name="logfolder" value="${os.logdir}" />

    <!-- Rolling File Appender -->
    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${logfolder}/app-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger for com.igearfs package -->
    <logger name="com.igearfs" level="debug" additivity="false">
        <appender-ref ref="ROLLING" />
    </logger>

    <!-- Root Logger -->
    <root level="debug">
        <appender-ref ref="ROLLING" />
    </root>

</configuration>
