<configuration>

    <!-- Rolling File Appender -->
    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- Log file path -->
        <file>${user.home}/AppData/Roaming/SyncSyndicate/logs/app.log</file>

        <!-- Rolling Policy (TimeBased) -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Logs will roll every day. Adjust for weekly or other intervals -->
            <fileNamePattern>${user.home}/AppData/Roaming/SyncSyndicate/logs/app-%d{yyyy-MM-dd}.log</fileNamePattern>

            <!-- Max history (e.g., delete logs older than 7 days) -->
            <maxHistory>7</maxHistory>

            <!-- Total size cap (optional) to ensure the total size doesn’t exceed a limit -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <!-- Log Encoder (log format) -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger -->
    <root level="debug">
        <appender-ref ref="ROLLING" />
    </root>

</configuration>
